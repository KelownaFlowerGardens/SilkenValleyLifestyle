</BaseLayout>

<style>
  .running-hero {
    max-width: 850px;
    margin: 0 auto 3rem;
    text-align: center;
    padding: 2rem 1rem;
  }

  .eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .running-hero h1,
  .running-section h2,
  .running-note h2 {
    color: var(--accent-dark);
  }

  .running-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }

  .running-hero p {
    line-height: 1.8;
  }

  .running-section {
    margin: 3rem 0;
  }

  .running-section h2,
  .running-note h2 {
    text-align: center;
  }

  .rule {
    height: 2px;
    max-width: 150px;
    background: var(--border);
    margin: 1rem auto 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
  }

  .card h3 {
    color: var(--accent-dark);
    margin-top: 0;
  }

  .card p {
    margin-bottom: 0;
    line-height: 1.7;
  }

  .feature {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 2rem;
  }

  .feature h3 {
    color: var(--accent-dark);
    margin-top: 0;
  }

  .feature p {
    line-height: 1.8;
    margin-bottom: 0;
  }

  .log-table {
    margin-top: 1.25rem;
    overflow-x: auto;
  }

  .log-row {
    display: grid;
    grid-template-columns: 1fr 0.7fr 0.7fr 1.5fr;
    gap: 0.75rem;
    min-width: 480px;
    padding: 0.85rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .log-heading {
    font-weight: 700;
    color: var(--accent-dark);
    background: var(--bg);
  }

  .running-note {
    text-align: center;
    background: var(--bg);
    border-radius: 16px;
    padding: 2rem;
    margin: 3rem 0;
  }

  .running-note p {
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .running-hero {
      padding: 1rem 0.5rem;
    }
  }
.feature img {
  display: block;
  margin: 1.5rem auto;
  max-width: 100%;
  height: auto;
}
</style>

