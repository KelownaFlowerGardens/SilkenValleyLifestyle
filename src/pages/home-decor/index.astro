<style>
  .decor-intro {
    max-width: 820px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .decor-intro h1,
  .decor-note h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-weight: 500;
    line-height: 1.25;
  }

  .decor-intro h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 16px;
  }

  .decor-intro > p:last-child {
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .decor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 35px 0 45px;
  }

  .decor-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 25px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .decor-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(80, 45, 55, 0.07);
  }

  .decor-number {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .decor-card h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .decor-card p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.75;
    margin: 0;
  }

  .decor-note {
    background: var(--rose-wash);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    margin: 35px 0;
    text-align: center;
  }

  .decor-note h2 {
    font-size: 1.7rem;
    margin: 0 0 12px;
  }

  .decor-note > p:last-child {
    color: var(--muted);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 700px) {
    .decor-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .decor-card {
      padding: 22px;
    }

    .decor-note {
      padding: 25px 20px;
    }
  }

.decor-affiliate {
  background: var(--rose-wash);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 30px;
  margin: 35px 0;
  text-align: center;
}

.decor-affiliate h2 {
  color: var(--text);
  font-family: Georgia, serif;
  font-size: 1.7rem;
  font-weight: 500;
  margin: 0 0 12px;
}

.decor-affiliate h3 {
  color: var(--accent-dark);
  font-family: Georgia, serif;
  font-size: 1.3rem;
  margin: 15px 0 10px;
}

.decor-affiliate > p:not(.eyebrow):not(.decor-affiliate-disclosure) {
  color: var(--muted);
  line-height: 1.7;
  max-width: 650px;
  margin: 0 auto 20px;
}

.decor-affiliate-button {
  display: inline-block;
  background: var(--accent);
  color: #ffffff;
  padding: 12px 25px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: background 0.2s ease;
}

.decor-affiliate-button:hover {
  background: var(--accent-dark);
}

.decor-affiliate-disclosure {
  color: var(--muted);
  font-size: 0.82rem;
  margin: 18px 0 0;
}

</style>
