<BaseLayout
  title="Fashion | Silken Valley Lifestyle"
  description="Timeless fashion, wardrobe inspiration, elegant everyday dressing, and thoughtfully selected fashion essentials."
  heroTitle="Fashion"
  heroText="Timeless style, wardrobe inspiration, and elegant everyday dressing."
  heroCompact={true}
>
  <section class="fashion-intro">
    <p class="eyebrow">Style & Personal Expression</p>
    <h1>The Art of Timeless Style</h1>
    <p>
      Discover the art of dressing well, from timeless wardrobe
      essentials and elegant everyday outfits to beautiful
      accessories, shoes, and seasonal fashion. Explore
      thoughtful style inspiration and carefully selected
      pieces that bring confidence and individuality to
      everyday dressing.
    </p>
  </section>

  <section class="fashion-grid">

    <article class="fashion-card">
      <div class="fashion-number">01</div>
      <h2>Wardrobe Essentials</h2>
      <p>
        Build a beautiful and versatile wardrobe with timeless
        staples, classic tailoring, quality fabrics, and
        carefully selected pieces that never go out of style.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">02</div>
      <h2>Everyday Style</h2>
      <p>
        Discover inspiration for effortless everyday dressing,
        from relaxed casual outfits and smart-casual combinations
        to polished looks for work, weekends, and special occasions.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">03</div>
      <h2>Shoes & Footwear</h2>
      <p>
        Explore beautiful and practical footwear, including
        classic pumps, elegant flats, comfortable walking shoes,
        boots, sandals, and timeless everyday favourites.
      </p>
    </article>

