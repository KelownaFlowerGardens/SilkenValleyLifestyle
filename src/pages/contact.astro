---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Silken Valley Lifestyle" description="Contact Silken Valley Lifestyle." heroTitle="Contact" heroText="Get in touch with Silken Valley Lifestyle." heroCompact={true}>
  <section class="panel">
    <p class="eyebrow">Contact</p>
    <h1>Contact</h1>
    <p>For questions, suggestions, or collaborations, add your preferred contact details here (email, social links, or a form endpoint).</p>
    <ul class="post-list">
      <li><strong>Website:</strong> <a href="https://silkenvalleylifestyle.ca">silkenvalleylifestyle.ca</a></li>
      <li><strong>Email:</strong> <em>Add your contact email</em></li>
      <li><strong>Social:</strong> <em>Add your social/profile links</em></li>
    </ul>
  </section>
</BaseLayout>
