
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoryLinks = {
  recipes: '/recipes/',
  dinner: '/recipes/dinner/',
  desserts: '/recipes/desserts/',
  breakfast: '/recipes/breakfast/',
  lunch: '/recipes/lunch/',
  baking: '/recipes/baking/',
  fitness: '/fitness/',
  workouts: '/fitness/workouts/',
  walking: '/fitness/walking/',
  'cat-care': '/cat-care/',
  'cat-nutrition': '/cat-care/cat-nutrition/',
  health: '/cat-care/health/',
  behaviour: '/cat-care/behaviour/',
  gardening: '/gardening/',
  'garden-design': '/gardening/garden-design/',
  flowers: '/gardening/flowers/',
  'trees-shrubs': '/gardening/trees-shrubs/',
  'garden-care': '/gardening/garden-care/',
  housekeeping: '/housekeeping/',
  cleaning: '/housekeeping/cleaning/',
  organization: '/housekeeping/organization/',
  laundry: '/housekeeping/laundry/',
  'home-management': '/housekeeping/home-management/',
};

---

<BaseLayout
  title={`${post.data.title} | Silken Valley Lifestyle`}
  description={post.data.description}
>
  <article>
    <p class="eyebrow">
      {post.data.category.map((category) => (
        <a
          href={categoryLinks[category] || '/'}
          style="margin-right: 12px;"
        >
          {category.replaceAll('-', ' ')}
        </a>
      ))}
    </p>

    <h1>{post.data.title}</h1>

    <p class="meta">
      {post.data.pubDate.toLocaleDateString('en-CA', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })}
    </p>

    <p>{post.data.description}</p>

    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>
