
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cat Care | Silken Valley Lifestyle"
  heroTitle="Cat Care"
  heroText="Helpful information for happy, healthy, well-cared-for cats."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Animal Care</p>
    <h1>Cat Care & Companionship</h1>
    <p>
      Discover practical advice and helpful information about
      feline health, nutrition, grooming, behaviour, and
      creating a comfortable home for your cat.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/cat-care/nutrition/">
      <h3>Cat Nutrition</h3>
      <p>Feeding, food choices, and healthy nutrition.</p>
    </a>

    <a class="card" href="/cat-care/grooming/">
      <h3>Grooming</h3>
      <p>Coat care, brushing, bathing, and everyday grooming.</p>
    </a>

    <a class="card" href="/cat-care/health/">
      <h3>Health & Wellness</h3>
      <p>General health, preventive care, and wellbeing.</p>
    </a>

    <a class="card" href="/cat-care/behaviour/">
      <h3>Behaviour</h3>
      <p>Understanding feline behaviour and encouraging good habits.</p>
    </a>
  </section>
</BaseLayout>
