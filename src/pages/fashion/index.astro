
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fashion | Silken Valley Lifestyle"
  description="Timeless fashion, wardrobe inspiration, elegant everyday dressing, and thoughtfully selected fashion essentials."
  heroTitle="Fashion"
  heroText="Timeless style, wardrobe inspiration, and elegant everyday dressing."
  heroCompact={true}
>
  <section class="fashion-intro">
    <p class="eyebrow">Style & Personal Expression</p>
    <h1>The Art of Timeless Style</h1>
    <p>
      Discover the art of dressing well, from timeless wardrobe
      essentials and elegant everyday outfits to beautiful
      accessories, shoes, and seasonal fashion. Explore
      thoughtful style inspiration and carefully selected
      pieces that bring confidence and individuality to
      everyday dressing.
    </p>
  </section>

  <section class="fashion-grid">

    <article class="fashion-card">
      <div class="fashion-number">01</div>
      <h2>Wardrobe Essentials</h2>
      <p>
        Build a beautiful and versatile wardrobe with timeless
        staples, classic tailoring, quality fabrics, and
        carefully selected pieces that never go out of style.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">02</div>
      <h2>Everyday Style</h2>
      <p>
        Discover inspiration for effortless everyday dressing,
        from relaxed casual outfits and smart-casual combinations
        to polished looks for work, weekends, and special occasions.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">03</div>
      <h2>Shoes & Footwear</h2>
      <p>
        Explore beautiful and practical footwear, including
        classic pumps, elegant flats, comfortable walking shoes,
        boots, sandals, and timeless everyday favourites.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">04</div>
      <h2>Handbags</h2>
      <p>
        Discover handbags for every occasion, from elegant
        everyday totes and classic shoulder bags to beautiful
        evening bags, crossbody styles, and timeless accessories.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">05</div>
      <h2>Jewellery & Accessories</h2>
      <p>
        Complete an outfit with beautiful finishing touches.
        Explore jewellery, scarves, belts, sunglasses, watches,
        and accessories that add personality and refinement.
      </p>
    </article>

    
<article class="fashion-card">
  <div class="fashion-number">06</div>
  <h2>Seasonal Fashion</h2>
  <p>
    Find inspiration for every season, from light spring
    layers and summer dresses to autumn textures and
    beautifully coordinated winter wardrobes.
  </p>

  <section class="fashion-affiliate">
    <p class="eyebrow">Seasonal Fashion</p>
    <h2>Featured Seasonal Fashion Find</h2>

    <h3>Seasonal Wardrobe Favourite</h3>

    <p>
      Discover a stylish addition to your seasonal wardrobe.
      Explore this fashion find for inspiration when putting
      together beautiful and versatile outfits throughout the year.
    </p>

    <a
      class="fashion-affiliate-button"
      href="https://www.amazon.ca/gp/aw/d/B0CD7M5ZRJ?pd_rd_plhdr=t&hsa_cr_id=0&qid=1795626243&sr=1-3-fec03104-6f11-4242-8f79-15fae2896f66&i=aps&aref=WIm7KTFwJH&_encoding=UTF8&pd_rd_w=Mytel&content-id=amzn1.sym.ebc362a9-70af-442c-98bb-5c97bff7fac6%3Aamzn1.sym.ebc362a9-70af-442c-98bb-5c97bff7fac6&pf_rd_p=ebc362a9-70af-442c-98bb-5c97bff7fac6&pf_rd_r=QGF4FGSKMN41K6KV69ND&pd_rd_wg=Y4S3m&pd_rd_r=8e30e71f-a9f5-4b1c-b144-1336feedcb42&th=1&linkCode=ll2&tag=silkenvalleyl-20&linkId=5529b8a36881c7dafe9fda83f6467249&gaOptInStatus=true&ref_=as_li_ss_tl"
      target="_blank"
      rel="sponsored nofollow noopener"
    >
      Shop on Amazon
    </a>
  </section>
</article>


    <article class="fashion-card">
      <div class="fashion-number">07</div>
      <h2>Coats</h2>
      <p>
        Explore classic coats, elegant jackets, tailored blazers,
        cardigans, and comfortable layering pieces that combine
        practicality with timeless style.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">08</div>
      <h2>Luxury Fashion</h2>
      <p>
        Refine your style, quality craftsmanship,
        fine materials, designer inspiration, and
        investment pieces that bring enduring elegance
        to a personal wardrobe.
      </p>
    </article>

    <article class="fashion-card">
      <div class="fashion-number">09</div>
      <h2>Fashion Finds</h2>
      <p>
        Browse thoughtfully selected fashion discoveries,
        wardrobe favourites, useful essentials, and
        recommendations for pieces that combine style,
        versatility, and value.
      </p>
    </article>

  </section>
 <article class="fashion-card">
      <div class="fashion-number">10</div>
      <h2>Clothing Stores</h2>
      <p>
        The best Kelowna and the Okanagan Region has to offer.
      </p>
    </article>

  </section>


  <section class="fashion-note">
    <p class="eyebrow">A Personal Sense of Style</p>
    <h2>Elegance is always in style</h2>
    <p>
      True style is not about following trends.
      It is about discovering what makes you feel comfortable,
      confident, and beautifully yourself. Build a wardrobe
      that reflects your personality and celebrates the
      pleasure of everyday dressing.
    </p>
  </section>

</BaseLayout>

<style>
  .fashion-intro {
    max-width: 820px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .fashion-intro h1,
  .fashion-note h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-weight: 500;
    line-height: 1.25;
  }

  .fashion-intro h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 16px;
  }

  .fashion-intro > p:last-child {
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .fashion-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 35px 0 45px;
  }

  .fashion-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 25px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fashion-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(80, 45, 55, 0.07);
  }

  .fashion-number {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .fashion-card h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .fashion-card p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.75;
    margin: 0;
  }

  .fashion-note {
    background: var(--rose-wash);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    margin: 35px 0;
    text-align: center;
  }

  .fashion-note h2 {
    font-size: 1.7rem;
    margin: 0 0 12px;
  }

  .fashion-note > p:last-child {
    color: var(--muted);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 700px) {
    .fashion-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .fashion-card {
      padding: 22px;
    }

    .fashion-note {
      padding: 25px 20px;
    }
  }
</style>
