
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fitness | Silken Valley Lifestyle"
  heroTitle="Fitness"
  heroText="Movement, wellness, recovery, and healthy everyday habits."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Health & Wellness</p>
    <h1>Fitness & Active Living</h1>
    <p>
      Explore practical fitness routines, exercise inspiration,
      healthy habits, and ways to build strength, flexibility,
      and balance into everyday life.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/fitness/workouts/">
      <h3>Workouts</h3>
      <p>Exercise routines for strength, endurance, and fitness.</p>
    </a>

    <a class="card" href="/fitness/walking/">
      <h3>Walking & Cardio</h3>
      <p>Simple ways to stay active and improve endurance.</p>
    </a>

    <a class="card" href="/fitness/stretching/">
      <h3>Stretching & Flexibility</h3>
      <p>Movement, mobility, and flexibility exercises.</p>
    </a>

    <a class="card" href="/fitness/recovery/">
      <h3>Recovery</h3>
      <p>Rest, recovery, and maintaining healthy routines.</p>
    </a>
  </section>
</BaseLayout>
