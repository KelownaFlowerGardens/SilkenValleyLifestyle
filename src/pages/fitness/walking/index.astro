
---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const categories = [
  {
    href: '/fitness/walking/beginner-walking/',
    title: 'Beginner Walking',
    text: 'Build a comfortable walking routine and develop consistency.'
  },
  {
    href: '/fitness/walking/power-walking/',
    title: 'Power Walking',
    text: 'Improve endurance, pace, and cardiovascular fitness.'
  },
  {
    href: '/fitness/walking/cardio-exercises/',
    title: 'Cardio Exercises',
    text: 'Explore activities that support heart health and stamina.'
  },
  {
    href: '/fitness/walking/indoor-cardio/',
    title: 'Indoor Cardio',
    text: 'Stay active with practical indoor movement routines.'
  },
  {
    href: '/fitness/walking/outdoor-activities/',
    title: 'Outdoor Activities',
    text: 'Enjoy fresh air through outdoor fitness and recreation.'
  }
];
---

<BaseLayout
  title="Walking & Cardio | Silken Valley Lifestyle"
  heroTitle="Walking & Cardio"
  heroText="Discover enjoyable ways to stay active, improve endurance, and make movement part of everyday life."
  heroCompact={true}
>
  <section>
    <h2>Explore Walking & Cardio</h2>
    <p>
      From gentle daily walks to more energetic cardiovascular activities,
      find practical inspiration for building an active lifestyle.
    </p>

    <div class="grid">
      {categories.map((category) => (
        <a class="card" href={category.href}>
          <h3>{category.title}</h3>
          <p>{category.text}</p>
        </a>
      ))}
    </div>
  </section>

  <p>
    <a href="/fitness/">← Return to Fitness</a>
  </p>
</BaseLayout>
