
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Breakfast Recipes | Silken Valley Lifestyle"
  heroTitle="Breakfast"
  heroText="Fresh inspiration for a delicious start to the day."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">The Kitchen</p>
    <h1>Breakfast Recipes</h1>
    <p>
      Discover nourishing breakfasts, homemade favourites,
      fresh fruit ideas, and delicious morning meals.
    </p>
  </section>

  <section class="latest">
    <h2>Breakfast Inspiration</h2>
    <p>Our breakfast recipe collection is coming soon.</p>
  </section>

  <p><a href="/recipes/">← Return to Recipes</a></p>
</BaseLayout>
