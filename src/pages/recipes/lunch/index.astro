
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lunch Recipes | Silken Valley Lifestyle"
  heroTitle="Lunch"
  heroText="Fresh, simple, and satisfying midday meals."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">The Kitchen</p>
    <h1>Lunch Recipes</h1>
    <p>
      Explore fresh salads, homemade soups, sandwiches,
      and delicious ideas for everyday lunches.
    </p>
  </section>

  <section class="latest">
    <h2>Lunch Inspiration</h2>
    <p>Our lunch recipe collection is coming soon.</p>
  </section>

  <p><a href="/recipes/">← Return to Recipes</a></p>
</BaseLayout>
