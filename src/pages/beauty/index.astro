<style>
  .beauty-intro {
    max-width: 820px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .beauty-intro h1,
  .beauty-note h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-weight: 500;
    line-height: 1.25;
  }

  .beauty-intro h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 16px;
  }

  .beauty-intro > p:last-child {
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .beauty-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 35px 0 45px;
  }

  .beauty-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 25px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .beauty-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(80, 45, 55, 0.07);
  }

  .beauty-number {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .beauty-card h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .beauty-card p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.75;
    margin: 0;
  }

  .beauty-note {
    background: var(--rose-wash);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    margin: 35px 0;
    text-align: center;
  }

  .beauty-note h2 {
    font-size: 1.7rem;
    margin: 0 0 12px;
  }

  .beauty-note > p:last-child {
    color: var(--muted);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 700px) {
    .beauty-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .beauty-card {
      padding: 22px;
    }

    .beauty-note {
      padding: 25px 20px;
    }
  }

.beauty-affiliate {
  background: var(--rose-wash);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 30px;
  margin: 35px 0;
  text-align: center;
}

.beauty-affiliate h2 {
  color: var(--text);
  font-family: Georgia, serif;
  font-size: 1.7rem;
  font-weight: 500;
  margin: 0 0 12px;
}

.beauty-affiliate h3 {
  color: var(--accent-dark);
  font-family: Georgia, serif;
  font-size: 1.3rem;
  margin: 15px 0 10px;
}

.beauty-affiliate > p:not(.eyebrow):not(.beauty-affiliate-disclosure) {
  color: var(--muted);
  line-height: 1.7;
  max-width: 650px;
  margin: 0 auto 20px;
}

.beauty-affiliate-button {
  display: inline-block;
  background: var(--accent);
  color: #ffffff;
  padding: 12px 25px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: background 0.2s ease;
}

.beauty-affiliate-button:hover {
  background: var(--accent-dark);
}

.beauty-affiliate-disclosure {
  color: var(--muted);
  font-size: 0.82rem;
  margin: 18px 0 0;
}

.beauty-fragrance-card {
  background: linear-gradient(
    145deg,
    #fcf3f5 0%,
    #ffffff 75%
  );
  border: 1px solid #eadde1;
  box-shadow: 0 5px 18px rgba(169, 79, 107, 0.08);
}

.beauty-card-eyebrow {
  color: var(--accent-dark);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin: 8px 0 12px;
}

.beauty-fragrance-card h2 {
  font-family: Georgia, serif;
  color: var(--accent-dark);
  font-size: 1.65rem;
  font-weight: 500;
  margin-bottom: 16px;
}

.beauty-fragrance-card p:not(.beauty-card-eyebrow) {
  color: var(--muted);
  line-height: 1.8;
  margin-bottom: 16px;
}

.beauty-card-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 8px;
  padding: 13px 22px;
  background: linear-gradient(135deg, #c76b85, #a94f6b);
  color: #ffffff;
  border: 1px solid #a94f6b;
  border-radius: 6px;
  font-family: Georgia, serif;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 4px 10px rgba(169, 79, 107, 0.16);
  transition: all 0.25s ease;
}

.beauty-card-link:hover {
  background: #ffffff;
  color: #a94f6b;
  transform: translateY(-2px);
  box-shadow: 0 5px 14px rgba(169, 79, 107, 0.2);
}

</style>
