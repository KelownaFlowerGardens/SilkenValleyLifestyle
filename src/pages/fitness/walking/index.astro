  <section class="walking-routine">
    <p class="eyebrow">Consistency</p>
    <h2>A Sample Weekly Walking Schedule</h2>
    <p>
      Use this example as a starting point. Adjust the
      walking duration, pace, and number of sessions
      according to your current fitness and schedule.
    </p>

    <div class="walking-table">
      <div class="walking-row">
        <strong>Monday</strong>
        <span>Comfortable 20-minute walk</span>
      </div>
      <div class="walking-row">
        <strong>Tuesday</strong>
        <span>Brisk walking intervals</span>
      </div>
      <div class="walking-row">
        <strong>Wednesday</strong>
        <span>Gentle recovery walk</span>
      </div>
      <div class="walking-row">
        <strong>Thursday</strong>
        <span>Steady-paced outdoor walk</span>
      </div>
      <div class="walking-row">
        <strong>Friday</strong>
        <span>Treadmill or neighbourhood walk</span>
      </div>
      <div class="walking-row">
        <strong>Saturday</strong>
        <span>Longer recreational walk</span>
      </div>
      <div class="walking-row">
        <strong>Sunday</strong>
        <span>Rest or gentle movement</span>
      </div>
    </div>
  </section>

  <section class="walking-note">
    <h2>Make Walking Part of Your Lifestyle</h2>
    <p>
      The best walking routine is one you can enjoy and
      maintain. Wear comfortable, supportive footwear,
      stay hydrated, and dress appropriately for the
      weather. Begin at a manageable pace and gradually
      increase your activity. Allow time for rest and
      recovery, and seek professional guidance if you
      have concerns about starting a new exercise routine.
    </p>
  </section>

  <section class="walking-links">
    <h2>Explore More Fitness Activities</h2>
    <div class="walking-link-grid">
      <a href="/fitness/workouts/">Workouts & Exercise Routines →</a>
      <a href="/fitness/workouts/cardio/">Cardio Workouts →</a>
      <a href="/fitness/workouts/low-impact/">Low-Impact Exercise →</a>
      <a href="/fitness/stretching/">Stretching & Flexibility →</a>
    </div>
  </section>

  <p class="walking-back">
    <a href="/fitness/">← Return to Fitness</a>
  </p>
</BaseLayout>

<style>
  .walking-intro {
    margin: 30px 0;
    padding: 28px;
    background: var(--rose-wash);
    border-radius: 18px;
  }

  .walking-intro h2,
  .walking-routine h2,
  .walking-note h2,
  .walking-links h2 {
    font-family: Georgia, serif;
    font-size: 1.7rem;
    font-weight: 500;
    margin: 0 0 14px;
    color: var(--text);
  }

  .walking-intro p,
  .walking-routine > p:not(.eyebrow),
  .walking-note p {
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }

  .walking-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 35px 0;
  }

  .walking-card {
    padding: 28px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 18px;
  }

  .walking-number {
    display: inline-block;
    color: var(--accent-dark);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    margin-bottom: 14px;
  }

  .walking-card h2 {
    font-family: Georgia, serif;
    font-size: 1.55rem;
    font-weight: 500;
    color: var(--text);
    margin: 0 0 13px;
  }

  .walking-card h3 {
    font-family: Georgia, serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent-dark);
    margin: 22px 0 10px;
  }

  .walking-card p,
  .walking-card li {
    color: var(--muted);
    line-height: 1.75;
  }

  .walking-card p {
    margin: 0;
  }

  .walking-card ul {
    padding-left: 20px;
    margin-bottom: 0;
  }

  .walking-routine {
    margin: 40px 0;
  }

  .walking-routine .eyebrow {
    color: var(--accent-dark);
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .walking-table {
    margin-top: 22px;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .walking-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 15px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .walking-row:last-child {
    border-bottom: none;
  }

  .walking-row strong {
    color: var(--accent-dark);
  }

  .walking-row span {
    color: var(--muted);
  }

  .walking-note {
    padding: 30px;
    margin: 40px 0;
    background: var(--rose-wash);
    border-radius: 18px;
  }

  .walking-links {
    margin: 40px 0;
  }

  .walking-link-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-top: 20px;
  }

  .walking-link-grid a {
    display: block;
    padding: 18px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--accent-dark);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .walking-link-grid a:hover {
    background: var(--rose-wash);
  }

  .walking-back {
    margin-top: 30px;
  }

  .walking-back a {
    color: var(--accent-dark);
    text-decoration: none;
    font-weight: 600;
  }

  .walking-back a:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .walking-grid {
      grid-template-columns: 1fr;
    }

    .walking-link-grid {
      grid-template-columns: 1fr;
    }

    .walking-row {
      grid-template-columns: 1fr;
      gap: 5px;
    }
  }
</style>
