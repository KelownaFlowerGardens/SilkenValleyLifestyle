---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';



const categories = [
  { href: '/recipes/', title: 'Recipes', text: 'Simple meals, seasonal cooking, and kitchen tips.' },
  { href: '/fitness/', title: 'Fitness', text: 'Movement routines, recovery, and healthy habits.' },
  { href: '/cat-care/', title: 'Cat Care', text: 'Care guides for pets and everyday wellbeing.' },
  { href: '/gardening/', title: 'Gardening', text: 'Plant care, garden planning, and outdoor projects.' },
  { href: '/housekeeping/', title: 'Good Housekeeping', text: 'Cleaning routines, organization, and home systems.' },
  { href: '/home-decor/', title: 'Home Decor', text: 'Interior decorating, colour inspiration, furniture, and beautiful living spaces.' },
  { href: '/beauty/', title: 'Beauty', text: 'Skincare, makeup, hair care, fragrance, and everyday beauty rituals.' },
];


const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<BaseLayout
  title="Silken Valley Lifestyle | Home"
  headerImage="/images/Banner.png"
>

  <section class="hero">
    <p class="eyebrow">Home & Lifestyle</p>
    <h1>Ideas for a well-run home and routines for consistent success.</h1>
    <p>Explore recipes, fitness, cat care, gardening, decor, beauty and good housekeeping.</p>
  </section>

  <section aria-labelledby="categories-heading">
    <h2 id="categories-heading">Categories</h2>
    <div class="grid">
      {categories.map((c) => (
        <a class="card" href={c.href}>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="latest-heading" class="latest">
    <h2 id="latest-heading">Recent Posts</h2>
    {posts.length ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
           <a href={`/posts/${post.slug}/`}>
  <strong>{post.data.title}</strong>
</a>
           <div class="meta">
  {post.data.category.map((category) => category.replaceAll('-', ' ')).join(' · ')}
  · {post.data.pubDate.toLocaleDateString('en-CA')}
</div>
            <div>{post.data.description}</div>
          </li>
        ))}
      </ul>
    ) : (
      <p> <a class="card" href="src/pages/housekeeping/home-management/weekly-routine.astro"> </a>
</p>
    )}
  </section>
</BaseLayout>
