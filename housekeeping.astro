---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.category === 'housekeeping'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Good Housekeeping | Silken Valley Lifestyle" description="Cleaning routines, organization, and home systems.">
  <h1>Good Housekeeping</h1>
  <p>Cleaning routines, organization, and systems that keep a home running smoothly.</p>
  {posts.length ? (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.slug}/`}><strong>{post.data.title}</strong></a>
          <div class="meta">{post.data.pubDate.toLocaleDateString('en-CA')}</div>
          <div>{post.data.description}</div>
        </li>
      ))}
    </ul>
  ) : (
    <p><h2>Weekly Routine</h2>

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{background:#fff}
*{box-sizing:border-box}
body{margin:0;background:#fff;color:#c2547a;font-family:'Caveat','Segoe Script','Bradley Hand','Brush Script MT',cursive;font-size:24px;line-height:1.3}
.page{max-width:900px;margin:0 auto;padding:40px 32px 56px}
h1{font-size:64px;font-weight:700;text-align:center;margin:0 0 8px;letter-spacing:1px}
h2{font-size:40px;font-weight:700;margin:40px 0 12px;text-align:center}
.rule{width:120px;height:3px;background:#c2547a;margin:0 auto 24px;border-radius:2px;opacity:.5}
.day{margin:0 0 18px}
.day b{font-size:32px;font-weight:700;display:block}
.day p{margin:0}
ul{margin:0;padding-left:28px}
li{margin:4px 0}
@media(max-width:600px){body{font-size:21px}h1{font-size:46px}h2{font-size:34px}.day b{font-size:28px}}
</style>
</head>
<body>
<div class="page">
<h1>Weekly Routine</h1>
<div class="rule"></div>

<div class="day"><b>Sunday: Deep Clean</b><p>Start the week off with everything fresh, because you deserve the peace of mind to start your week off right.</p></div>
<div class="day"><b>Monday: Clean Bedrooms</b><p>Vacuum, sheets, windows, surfaces.</p></div>
<div class="day"><b>Tuesday: Laundry*</b><p>Wash colours, blacks. Also clean all the bathrooms.</p></div>
<div class="day"><b>Wednesday: Kitchen Reset</b><p>Clean toaster crumbs, empty fridge leftovers, clean stovetop, wash sink stoppers in dishwasher, clean out compost bin, clean out garbage/recycling bin and add new bags, wipe down surfaces, fill up soap containers (dish/hand), refill cleaning wipe containers and paper towels.</p></div>
<div class="day"><b>Thursday: Laundry*</b><p>Wash whites, throw blankets, towels, house robe, dish clothes, hand clothes and face cloths.</p></div>
<div class="day"><b>Friday</b><p>Wash sheets, pillow cases, throw blankets.</p></div>

<h2>Everyday Reminders</h2>
<div class="rule"></div>
<ul>
<li>Go to bed with a clean kitchen, no dishes left out or in the sink</li>
<li>Dishwasher on</li>
<li>Laundry/dryer on</li>
<li>Check/refill of toilet paper roll holders</li>
<li>Switch out dish cloths</li>
<li>Refill tissue paper holders</li>
<li>Grind coffee</li>
<li>Refill water coolers in gym</li>
<li>Fold throw blankets/fluff pillows daily</li>
</ul>
</div>
</body></p>
  )}
</BaseLayout>
