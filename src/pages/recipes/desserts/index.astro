
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const dessertPosts = (await getCollection('posts', ({ data }) =>
  !data.draft && data.category.includes('desserts')
)).sort((a, b) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Desserts & Baking | Silken Valley Lifestyle"
  heroTitle="Desserts & Baking"
  heroText="Homemade desserts, beautiful baking, and sweet inspiration."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">The Kitchen</p>
    <h1>Desserts & Baking</h1>
   <a class="card" href="/posts/cinnamon-rolls/">
  <h3>The Best Cinnamon Rolls You'll Ever Eat</h3>
  <p>Discover our homemade cinnamon rolls recipe.</p>
</a>
  </section>

  <section class="latest">
    <h2>Sweet Inspiration</h2>

    {dessertPosts.length > 0 ? (
      <ul class="post-list">
        {dessertPosts.map((post) => (
          <li>
         <a href={`/posts/${post.slug}/`}>
              <strong>{post.data.title}</strong>
            </a>

            <div class="meta">
              {post.data.pubDate.toLocaleDateString('en-CA', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </div>

            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>New dessert and baking recipes are coming soon.</p>
    )}
  </section>

  <p><a href="/recipes/">← Return to Recipes</a></p>
</BaseLayout>
