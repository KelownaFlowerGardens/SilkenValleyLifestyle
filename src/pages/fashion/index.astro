<style>
  .fashion-intro {
    max-width: 820px;
    margin: 0 auto 38px;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .fashion-intro h1,
  .fashion-note h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-weight: 500;
    line-height: 1.25;
  }

  .fashion-intro h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 16px;
  }

  .fashion-intro > p:last-child {
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .fashion-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 35px 0 45px;
  }

  .fashion-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 25px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fashion-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(80, 45, 55, 0.07);
  }

  .fashion-number {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .fashion-card h2 {
    color: var(--text);
    font-family: Georgia, serif;
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 10px;
  }

  .fashion-card p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.75;
    margin: 0;
  }

  .fashion-note {
    background: var(--rose-wash);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    margin: 35px 0;
    text-align: center;
  }

  .fashion-note h2 {
    font-size: 1.7rem;
    margin: 0 0 12px;
  }

  .fashion-note > p:last-child {
    color: var(--muted);
    line-height: 1.8;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 700px) {
    .fashion-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .fashion-card {
      padding: 22px;
    }

    .fashion-note {
      padding: 25px 20px;
    }
  }

.fashion-affiliate {
  background: var(--rose-wash);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 25px;
  margin: 25px 0 0;
  text-align: center;
}

.fashion-affiliate h2 {
  font-family: Georgia, serif;
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--text);
  margin: 0 0 12px;
}

.fashion-affiliate h3 {
  color: var(--accent-dark);
  font-family: Georgia, serif;
  font-size: 1.2rem;
  margin: 15px 0 10px;
}

.fashion-affiliate > p:not(.eyebrow) {
  color: var(--muted);
  line-height: 1.7;
  margin: 0 auto 20px;
}

.fashion-affiliate-button {
  display: inline-block;
  background: var(--accent);
  color: #ffffff;
  padding: 12px 25px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: background 0.2s ease;
}

.fashion-affiliate-button:hover {
  background: var(--accent-dark);
}

</style>
