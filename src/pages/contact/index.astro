
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Silken Valley Lifestyle"
  heroTitle="Contact Us"
  heroText="I would love to hear from you."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Get In Touch</p>
    <h1>Contact Silken Valley Lifestyle</h1>
    <p>
      Have a question, suggestion, collaboration idea, or simply
      want to connect? I welcome hearing from our readers and
      visitors.
    </p>
  </section>

  <section class="latest">
    <h2>General Inquiries</h2>
    <p>
      For questions about our articles, website content,
      suggestions, or general inquiries, please contact us
      by email.
    </p>

    <p>
      <strong>Email:</strong>
      <a href="mailto:kelownaflowergardens@gmail.com">
kelownaflowergardens@gmail.com
      </a>
    </p>
  </section>

  <section class="latest">
    <h2>Partnerships</h2>
    <p>
      We welcome opportunities to collaborate with businesses,
      writers, creators, and individuals who share an interest
      in home, gardening, food, fitness, animal care, and lifestyle.
    </p>
  </section>

  <section class="latest">
    <h2>Stay Connected</h2>
    <p>
      Thank you for visiting Silken Valley Lifestyle.
      We appreciate your interest and look forward to connecting
      with you.
    </p>
  </section>
</BaseLayout>
