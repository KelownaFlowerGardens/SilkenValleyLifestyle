
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Housekeeping | Silken Valley Lifestyle"
  heroTitle="Good Housekeeping"
  heroText="Practical ideas for an organized, comfortable, and welcoming home."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Home & Organization</p>
    <h1>Good Housekeeping & Home Management</h1>
    <p>
      Explore practical cleaning routines, home organization,
      household management, and ideas for maintaining a
      beautiful and comfortable living environment.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/housekeeping/cleaning/">
      <h3>Cleaning & Maintenance</h3>
      <p>Cleaning routines, household care, and maintenance tips.</p>
    </a>

    <a class="card" href="/housekeeping/organization/">
      <h3>Home Organization</h3>
      <p>Decluttering, storage, and creating organized spaces.</p>
    </a>

    <a class="card" href="/housekeeping/laundry/">
      <h3>Laundry & Fabrics</h3>
      <p>Fabric care, laundry techniques, and household essentials.</p>
    </a>

    <a class="card" href="/housekeeping/home-management/">
      <h3>Home Management</h3>
      <p>Household schedules, planning, and everyday systems.</p>
    </a>
  </section>
</BaseLayout>
