
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Silken Valley Lifestyle"
  description="Discover Silken Valley Lifestyle, explore our interests, and get in touch."
  heroTitle="Contact Us"
  heroText="Discover Silken Valley Lifestyle and connect with us."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Our Story</p>
    <h1>Welcome to Silken Valley Lifestyle</h1>

    <p>
      Silken Valley Lifestyle is a place to explore ideas,
      inspiration, and practical knowledge for everyday living.
      Our goal is to bring together useful information that
      encourages creativity, confidence, and a more fulfilling
      approach to home and lifestyle.
    </p>
  </section>

  <section>
    <h2>What We Explore</h2>

    <div class="grid">
      <div class="card">
        <h3>Recipes</h3>
        <p>Cooking inspiration, seasonal ingredients, and delicious ideas.</p>
      </div>

      <div class="card">
        <h3>Fitness & Wellness</h3>
        <p>Healthy routines, movement, and everyday wellbeing.</p>
      </div>

      <div class="card">
        <h3>Cat Care</h3>
        <p>Helpful information for responsible and thoughtful cat care.</p>
      </div>

      <div class="card">
        <h3>Gardening</h3>
        <p>Garden design, horticulture, flowers, and outdoor living.</p>
      </div>

      <div class="card">
        <h3>Good Housekeeping</h3>
        <p>Home organization, cleaning, and practical household management.</p>
      </div>
    </div>
  </section>

  <section class="latest">
    <h2>Our Philosophy</h2>
    <p>
      I believe that a well-rounded lifestyle is built through
      effort, thoughtful choices, practical knowledge, and
      an appreciation for the everyday details that make a house
      a home.
    </p>
  </section>

  <section class="latest">
    <p class="eyebrow">Get In Touch</p>
    <h2>Contact Silken Valley Lifestyle</h2>
    <p>
      Have a question, suggestion, collaboration idea, or simply
      want to connect? I welcome hearing from our readers and
      visitors.
    </p>
  </section>

  <section class="latest">
    <h2>General Inquiries</h2>
    <p>
      For questions about our articles, website content,
      suggestions, or general inquiries, please contact us
      by email.
    </p>

    <p>
      <strong>Email:</strong>
      <a href="mailto:kelownaflowergardens@gmail.com">
        kelownaflowergardens@gmail.com
      </a>
    </p>
  </section>

  <section class="latest">
    <h2>Partnerships</h2>
    <p>
      We welcome opportunities to collaborate with businesses,
      writers, creators, and individuals who share an interest
      in home, gardening, food, fitness, animal care, and lifestyle.
    </p>
  </section>

  <section class="latest">
    <h2>Stay Connected</h2>
    <p>
      Thank you for visiting Silken Valley Lifestyle.
      We appreciate your interest and look forward to connecting
      with you.
    </p>
  </section>
</BaseLayout>
