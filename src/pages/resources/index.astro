
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resources | Silken Valley Lifestyle"
  heroTitle="Resources"
  heroText="Helpful guides, useful information, and practical everyday references."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Knowledge & Inspiration</p>
    <h1>Resources & Helpful Guides</h1>
    <p>
      Explore a collection of useful information, practical
      references, educational guides, and ideas to help make
      everyday living more enjoyable and productive.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/resources/gardening-guides/">
      <h3>Gardening Guides</h3>
      <p>Plant references, garden planning, and horticultural information.</p>
    </a>

    <a class="card" href="/resources/recipe-guides/">
      <h3>Recipe Guides</h3>
      <p>Cooking references, ingredient information, and kitchen tips.</p>
    </a>

    <a class="card" href="/resources/home-guides/">
      <h3>Home Guides</h3>
      <p>Household references, organization, and practical advice.</p>
    </a>

    <a class="card" href="/resources/wellness-guides/">
      <h3>Wellness Guides</h3>
      <p>Fitness, healthy habits, and everyday wellbeing resources.</p>
    </a>
  </section>
</BaseLayout>
