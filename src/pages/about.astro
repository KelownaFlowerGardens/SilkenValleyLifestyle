---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About | Silken Valley Lifestyle" description="About Silken Valley Lifestyle." heroTitle="About" heroText="The story and purpose behind Silken Valley Lifestyle." heroCompact={true}>
  <article class="about">
    <img class="about-photo" src="/SilkenR.jpeg" alt="Silken Valley Lifestyle profile" width="160" height="160" loading="lazy" />
    <div>
      <p class="eyebrow">About</p>
      <h1>Silken Valley Lifestyle</h1>
      <p>Silken Valley Lifestyle shares practical ideas for everyday living — recipes, fitness, animal care, gardening, and good housekeeping.</p>
      <p>The goal is simple: useful routines, approachable guidance, and a well-run home.</p>
      <p class="quote">A calm, capable home is built from small habits, good food, care for living things, and time spent well.</p>
    </div>
  </article>
</BaseLayout>
