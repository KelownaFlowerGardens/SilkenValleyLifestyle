
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About | Silken Valley Lifestyle"
  heroTitle="About Us"
  heroText="Inspiration for a beautiful, balanced, and well-managed lifestyle."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Our Story</p>
    <h1>Welcome to Silken Valley Lifestyle</h1>

    <p>
      Silken Valley Lifestyle is a place to explore ideas,
      inspiration, and practical knowledge for everyday living.
      Our goal is to bring together useful information that
      encourages creativity, confidence, and a more fulfilling
      approach to home and lifestyle.
    </p>
  </section>

  <section>
    <h2>What We Explore</h2>

    <div class="grid">
      <div class="card">
        <h3>Recipes</h3>
        <p>Cooking inspiration, seasonal ingredients, and delicious ideas.</p>
      </div>

      <div class="card">
        <h3>Fitness & Wellness</h3>
        <p>Healthy routines, movement, and everyday wellbeing.</p>
      </div>

      <div class="card">
        <h3>Cat Care</h3>
        <p>Helpful information for responsible and thoughtful cat care.</p>
      </div>

      <div class="card">
        <h3>Gardening</h3>
        <p>Garden design, horticulture, flowers, and outdoor living.</p>
      </div>

      <div class="card">
        <h3>Good Housekeeping</h3>
        <p>Home organization, cleaning, and practical household management.</p>
      </div>
    </div>
  </section>

  <section class="latest">
    <h2>Our Philosophy</h2>
    <p>
      We believe that a well-rounded lifestyle is built through
      curiosity, thoughtful choices, practical knowledge, and
      an appreciation for the everyday details that make a house
      a home.
    </p>
  </section>
</BaseLayout>
