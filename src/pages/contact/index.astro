
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Silken Valley Lifestyle"
  description="Discover Silken Valley Lifestyle, explore our interests, and get in touch."
  heroTitle="Contact Us"
  heroText="Discover Silken Valley Lifestyle and connect with us."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Our Story</p>
    <h1>Welcome to Silken Valley Lifestyle</h1>

    <p>
      Silken Valley Lifestyle is a place to explore ideas,
      inspiration, and practical knowledge for everyday living.
      Our goal is to bring together useful information that
      encourages creativity, confidence, and a more fulfilling
      approach to home and lifestyle.
    </p>
  </section>


<section>
  <h2>What We Explore</h2>

  <div class="grid">
    <div class="card">
      <h3>Recipes</h3>
      <p>Cooking inspiration, seasonal ingredients, and delicious ideas.</p>
    </div>

    <div class="card">
      <h3>Fitness & Wellness</h3>
      <p>Healthy routines, movement, workouts, and everyday wellbeing.</p>
    </div>

    <div class="card">
      <h3>Animal Care</h3>
      <p>Helpful information and thoughtful guidance for animal care.</p>
    </div>

    <div class="card">
      <h3>Gardening</h3>
      <p>Garden design, horticulture, flowers, and outdoor living.</p>
    </div>


    <div class="card">
      <h3>Beauty</h3>
      <p>Beauty inspiration, skincare, cosmetics, and personal care.</p>
    </div>

 <div class="card">
      <h3>Fashion</h3>
      <p>Timeless style, wardrobe inspiration, and elegant everyday dressing.</p>
    </div>

    <div class="card">
      <h3>Good Housekeeping</h3>
      <p>Home organization, cleaning, and practical household management.</p>
    </div>

    <div class="card">
      <h3>Home Decor</h3>
      <p>Interior inspiration, decorating ideas, and beautiful living spaces.</p>
    </div>

    <div class="card">
      <h3>Resources</h3>
      <p>Helpful guides, useful information, and everyday references.</p>
    </div>

    <div class="card">
      <h3>Recent Posts</h3>
      <p>Discover the latest articles, ideas, and inspiration from Silken Valley Lifestyle.</p>
    </div>
  </div>
</section>


  <section class="latest">
    <h2>General Inquiries</h2>
    <p>
      For questions about our articles, website content,
      suggestions, or general inquiries, please contact us
      by email.
    </p>

    <p>
      <strong>Email:</strong>
      <a href="mailto:kelownaflowergardens@gmail.com">
        kelownaflowergardens@gmail.com
      </a>
    </p>
  </section>

  <section class="latest">
    <h2>Partnerships</h2>
    <p>
      We welcome opportunities to collaborate with businesses,
      writers, creators, and individuals who share an interest
      in home, gardening, food, fitness, animal care, and lifestyle.
    </p>
  </section>


<section class="latest stay-connected">
  <h2>Stay Connected</h2>
  <p>
    Thank you for visiting Silken Valley Lifestyle.
    We appreciate your interest and invite you to explore
    our websites and follow along on Instagram.
  </p>

  <div class="social-links">
    <a
      href="https://www.kelownaflowergardens.com/Home"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button"
    >
      Kelowna Flower Gardens
    </a>

    <a
      href="https://www.instagram.com/kelownaflowergardens/"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button"
    >
      Instagram – Kelowna Flower Gardens
    </a>

    <a
      href="https://www.instagram.com/fragrances.house.rose/"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button"
    >
      Instagram – House Rose de Eau de Parfum
    </a>
  </div>
</section>

/* Stay Connected Social Buttons */

.social-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin-top: 25px;
}

.social-button {
  display: inline-block;
  padding: 12px 22px;
  background: var(--accent);
  color: #ffffff;
  border: 1px solid var(--accent);
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.92rem;
  text-align: center;
  transition: all 0.25s ease;
}

.social-button:hover {
  background: var(--accent-dark);
  border-color: var(--accent-dark);
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 5px 14px rgba(0, 0, 0, 0.12);
}

@media (max-width: 600px) {
  .social-links {
    flex-direction: column;
    align-items: center;
  }

  .social-button {
    width: 100%;
    max-width: 300px;
  }
}
</style>


</BaseLayout>
