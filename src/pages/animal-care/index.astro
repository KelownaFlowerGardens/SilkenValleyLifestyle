
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Cat Care | Silken Valley Lifestyle"
  heroTitle="Cat Care"
  heroText="Practical guidance for happy, healthy pets."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">Cat Care & Wellbeing</p>
    <h1>Animal Care & Everyday Companionship</h1>
    <p>
      Explore helpful information about cat care, nutrition,
      grooming, health, behaviour, and creating a comfortable
      environment for your animal companions.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/cat-care/cat-care/">
      <h3>Cat Care</h3>
      <p>Everyday care, grooming, and understanding your cat.</p>
    </a>

    <a class="card" href="/cat-care/cat-nutrition/">
      <h3>Cat Nutrition</h3>
      <p>Feeding, nutrition, and healthy eating habits.</p>
    </a>

    <a class="card" href="/cat-care/health/">
      <h3>Wellness</h3>
      <p>General health, preventive care, and wellbeing.</p>
    </a>

    <a class="card" href="/cat-care/behaviour/">
      <h3>Behaviour</h3>
      <p>Understanding behaviour and encouraging good habits.</p>
    </a>
  </section>
</BaseLayout>
