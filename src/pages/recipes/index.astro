
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recipes | Silken Valley Lifestyle"
  heroTitle="Recipes"
  heroText="Simple meals, seasonal cooking, and inspiration for your kitchen."
  heroCompact={true}
>
  <section class="hero">
    <p class="eyebrow">The Kitchen</p>
    <h1>Recipes & Seasonal Cooking</h1>
    <p>
      Discover delicious recipes, practical kitchen ideas, seasonal
      ingredients, and inspiration for everyday meals.
    </p>
  </section>

  <section class="grid">
    <a class="card" href="/recipes/breakfast/">
      <h3>Breakfast</h3>
      <p>Start the day with nourishing and delicious ideas.</p>
    </a>

    <a class="card" href="/recipes/lunch/">
      <h3>Lunch</h3>
      <p>Fresh, simple meals for midday inspiration.</p>
    </a>

    <a class="card" href="/recipes/dinner/">
      <h3>Dinner</h3>
      <p>Everyday meals and seasonal dinner inspiration.</p>
    </a>

    <a class="card" href="/recipes/desserts/">
      <h3>Desserts</h3>
      <p>Sweet treats, baking, and special occasions.</p>
    </a>
  </section>
</BaseLayout>
